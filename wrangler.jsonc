// Site Worker (spec 6.8): static assets only. There is no "main", so no script ever runs for visitors.
// Deployed only by .github/workflows/refresh.yml (decision D38). Staging: `wrangler deploy --env staging`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desi-desktop",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "name": "desi-desktop-staging",
      "workers_dev": true,
      "preview_urls": false
    }
  }
}

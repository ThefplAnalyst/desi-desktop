{
  "name": "desi-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budgets.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run sources:validate && npm run test",
    "test:e2e": "playwright test",
    "build:local": "vite build --base /desidesktop/local/ --outDir ../local && node scripts/local-data.ts local",
    "sources:validate": "node engine/run.ts --validate-only",
    "content:dry-run": "node engine/run.ts --out tmp/data --preview-curated",
    "build:local:engine": "npm run content:dry-run && vite build --base /desidesktop/local/ --outDir ../local && node scripts/local-data.ts local tmp/data"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
